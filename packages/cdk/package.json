{
  "name": "@cubecobra/cdk",
  "version": "0.1.0",
  "bin": {
    "infra": "app/infra.js",
    "bootstrap": "app/bootstrap.js",
    "pipeline": "app/pipeline.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:local": "cdklocal bootstrap --context environment=local --context version=1.0.0 && cdklocal deploy --context environment=local --context version=1.0.0",
    "deploy:pipeline": "npm run build && cdk deploy CubeCobraPipelineStack --app 'node app/pipeline.js'",
    "test:ci": "npx jest --coverage --coverageReporters text"
  },
  "type": "commonjs",
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.1",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.276.0",
    "aws-cdk-local": "^3.1.0",
    "constructs": "^10.8.1",
    "dotenv": "^18.0.10",
    "source-map-support": "^0.5.21"
  }
}
