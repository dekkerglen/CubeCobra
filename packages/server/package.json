{
  "name": "@cubecobra/server",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "copy-public": "copyfiles -u 0 -a 'public/**' dist/server/",
    "copy-content": "copyfiles -u 0 -a 'content/**' dist/server/",
    "fix-external-paths": "npx tsc-alias -p tsconfig.json",
    "build": "npm run write-git-info && npx tsc && npm run fix-external-paths && copyfiles -u 1 'src/**/*.pug' dist/server/src && npm run copy-public && npm run copy-content && copyfiles -u 2 'src/emails/**/*' dist/server/src/emails && copyfiles -u 1 'src/static/**' dist/server/src",
    "type-check": "npx tsc --noEmit",
    "start": "node server.js",
    "dev": "npm run write-git-info && tsx watch --include './src/router/routes/**/*.ts' ./src/index.ts",
    "clean": "rm -rf dist/ node_modules/ private/ ./src/client && node -e \"const fs = require('fs'); const path = require('path'); ['src', 'scripts', 'test'].forEach(dir => { try { require('child_process').execSync(\\`find ${dir} -name '*.js' -type f\\`, {encoding: 'utf8'}).trim().split('\\\\n').filter(Boolean).forEach(jsFile => { const tsFile = jsFile.replace(/\\\\.js$/, '.ts'); if (fs.existsSync(tsFile)) { fs.unlinkSync(jsFile); console.log('Deleted:', jsFile); }}); } catch(e) {} });\"",
    "test": "npm run write-git-info && npx jest --coverage=false",
    "test:watch": "npm run write-git-info && npx jest --watch --coverage=false",
    "test:coverage": "npm run write-git-info && npx jest --coverage",
    "test:ci": "npm run write-git-info && npx jest --coverage --coverageReporters json-summary text",
    "write-git-info": "tsx scripts/write-git-info.ts",
    "clinic:doctor": "clinic doctor -- node dist/server/src/index",
    "clinic:heap": "clinic heapprofiler -- node dist/server/src/index",
    "clinic:flame": "clinic flame -- node dist/server/src/index"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
