; Elastic Beanstalk runs `npm install --omit=dev` in this directory and there's
; no co-located lockfile (the workspace lockfile lives at the monorepo root).
; The AWS SDK packages publish on a rapid daily cadence and occasionally release
; client-X and lib-X with mismatched peer ranges for an hour or two; ERESOLVE
; would otherwise fail the deploy. The packages are API-compatible across
; minors so this is safe.
legacy-peer-deps=true
; Don't run dependency install scripts (preinstall/install/postinstall, node-gyp
; builds) during that on-instance install, which runs as root on a host holding
; the instance role. Nothing in the production tree needs one on Linux x64:
; sharp ships prebuilt binaries via its @img/* optional dependencies, and
; esbuild's postinstall (via tsx) is only an optimization. If a dependency that
; really needs an install script is added, it will fail at runtime here --
; revisit this rather than removing it. `npm start`/`npm run start` (Procfile)
; still run; only pre/post hooks are skipped and the server has none.
ignore-scripts=true
