dist/**/*
.git/**/*
node_modules/**/*
packages/server/dist/**/*
packages/server/src/client/**/*
packages/client/dist/**/*
packages/jobs/dist/**/*
packages/jobs/temp/**/*
# cdk compiles in-place alongside its .ts sources (no outDir), so ignore the generated
# .js/.d.ts artifacts throughout the package (the .ts sources are still checked).
packages/cdk/**/*.js
packages/cdk/**/*.d.ts
packages/recommenderService/model/**/*
packages/recommenderService/private/**/*
packages/utils/src/generated/**/*
packages/server/public/css/stylesheet.css
packages/annotator/**/*
# Generated migration checkpoint state, rewritten by the migration runner.
packages/scripts/src/dynamoMigrations/*.checkpoint.json
# Local agent scratch directories, excluded from git and not part of the project.
.superpowers/**/*
docs/superpowers/**/*
# Wiki content uses CubeCobra's custom Markdown extensions (>>> <<< centering, << >> cardrows).
# Prettier rewrites >>> into nested blockquotes (> > >), which breaks the rendered examples.
packages/server/content/wiki/**/*
# Git worktrees checked out inside the repo. Prettier reads .gitignore but not .git/info/exclude,
# where these are listed, so without this `prettier --write .` walks in and reformats another
# branch's files - including ones ignored above, whose patterns do not match one level down.
.worktrees/**/*
